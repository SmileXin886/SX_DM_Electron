{
  "name": "dreamina-toolkit",
  "version": "1.0.0",
  "description": "Dreamina Toolkit - Electron 桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 && electron .",
    "dev": "chcp 65001 && electron . --dev",
    "build": "electron-builder"
  },
  "author": "Dreamina",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "build": {
    "appId": "com.dreamina.toolkit",
    "productName": "Dreamina Toolkit",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "web_ui/**/*",
      "server.py",
      "preset_manager.py",
      "core/media_processor.py",
      "venv/**/*",
      "run.py"
    ],
    "extraResources": [
      {
        "from": "venv/Scripts/python.exe",
        "to": "python/python.exe"
      }
    ],
    "asar": false
  }
}
